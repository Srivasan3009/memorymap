# ── AI configuration ────────────────────────────────────────────────────────
# MemoryMap runs in mock AI mode by default so the demo works with NO keys.
# To use real AI, point the frontend at the Express proxy and configure a key.

# Frontend → backend proxy URL (leave empty to use built-in mock mode)
VITE_API_URL=http://localhost:3001

# Optional shared secret between frontend and backend (only required if set here)
VITE_API_KEY=

# ── Backend (server/.env) ──────────────────────────────────────────────────
# Provider: mock (default), openrouter, groq, gemini, or openai
AI_PROVIDER=mock

# OpenRouter (free models available — get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Groq (free tier — get a key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier — get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (alternative provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server port
PORT=3001